                    <div class="parallax-overlay">
                        <h2>Colecția Noastră</h2>
                        <p>Peste <strong>500 de console</strong> verificate în stoc, din toate generațiile și brandurile.</p>
                        <div class="parallax-stats">
                            <span><i class="fa-solid fa-gamepad"></i> PlayStation</span>
                            <span><i class="fa-solid fa-gamepad"></i> Xbox</span>
                            <span><i class="fa-solid fa-gamepad"></i> Nintendo</span>
                            <span><i class="fa-solid fa-gamepad"></i> Sega</span>
                        </div>
                    </div>
                </section>

                <!-- ZONA 7 — Date Server (placeholder) -->
                <section id="zona7">
                    <h2>Date Server</h2>
                    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Placeholder pentru sistem.</p>
                </section>

                <!-- ZONA 8 — Conținut principal -->
                <section id="zona8">

                    <!-- Promoții -->
                    <section id="promotii">
                        <div class="reflectie-container">
                            <h2 class="titlu-galerie">Promoții și oferte</h2>
                            <div class="reflectie" aria-hidden="true">Promoții și oferte</div>
                        </div>

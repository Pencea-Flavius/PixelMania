                                        <td>14-21</td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                        <td>Miercuri</td>
                                        <td>9-11</td>
                                        <td>11-13</td>
                                        <td>14-21</td>
                                    </tr>
                                    <tr>
                                        <td></td>
                                        <td>Joi</td>
                                        <td>9-11</td>
                                        <td>11-13</td>

<!DOCTYPE html>
<html lang="ro">

<head>

    <meta name="description"
        content="Magazin online specializat în vânzarea de console de jocuri video utilizate, de la modele retro până la generații actuale.">
    <meta name="keywords"
        content="console, jocuri video, second-hand, playstation, xbox, Nintendo, Sega,PS4,PS5,Xbox One,Xbox Series S/X,Switch 2,PS2,PS3,PS Vita,Xbox 360">
    <title>Pixel Mania — Magazine de console second-hand</title>
    <%- include('../fragmente/head.ejs') %>
    <link rel="stylesheet" href="/resurse/css/galerie.css" type="text/css" />

</head>

<script src="/resurse/js/video.js" defer></script>

<body>
    <%- include('../fragmente/header.ejs') %>

        <main>
            <!-- CERINTA ETAPA 7 (animatie-banner): cookie "ultim_produs" -->
            <% if (typeof ultimulProdusAccesat !== 'undefined' && ultimulProdusAccesat) { %>
                <p class="alert-cookie">Ultimul produs accesat (din cookie): <strong><%= ultimulProdusAccesat %></strong></p>
            <% } %>

            <!-- CERINTA ETAPA 7 (bootstrap_js_): Carusel cu 5 produse aleatoare din BD -->
            <% if (typeof produseCarousel !== 'undefined' && produseCarousel.length > 0) { %>
            <div id="caruselProduse" class="carousel slide carusel-custom"
                 data-bs-ride="carousel" data-bs-interval="3000">
                <!-- indicatori -->
                <div class="carousel-indicators">
                    <% for (let i = 0; i < produseCarousel.length; i++) { %>
                        <button type="button" data-bs-target="#caruselProduse"
                                data-bs-slide-to="<%= i %>"
                                class="<%= i === 0 ? 'active' : '' %>"
                                aria-label="Slide <%= i+1 %>"
                                <%= i === 0 ? 'aria-current="true"' : '' %>></button>
                    <% } %>
                </div>
                <!-- slide-urile -->
                <div class="carousel-inner">
                    <% for (let i = 0; i < produseCarousel.length; i++) { %>
                        <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
                            <img src="/resurse/imagini630/<%= produseCarousel[i].imagine %>"
                                 class="d-block w-100 carusel-img"
                                 alt="<%= produseCarousel[i].nume %>">
                            <!-- captiune cu nume + detalii -->
                            <div class="carousel-caption d-none d-md-block">
                                <h5><%= produseCarousel[i].nume %></h5>
                                <p>
                                    <%= produseCarousel[i].marca %> &middot;
                                    <%= produseCarousel[i].an_lansare %> &middot;
                                    <strong><%= produseCarousel[i].pret %> lei</strong>
                                </p>
                                <a href="/produs/<%= produseCarousel[i].id %>" class="btn btn-sm btn-light">Detalii</a>
                            </div>
                        </div>
                    <% } %>
                </div>
                <!-- controale -->
                <button class="carousel-control-prev" type="button"
                        data-bs-target="#caruselProduse" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Anterior</span>
                </button>
                <button class="carousel-control-next" type="button"
                        data-bs-target="#caruselProduse" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Urmator</span>
                </button>
            </div>
            <% } %>

            <div id="grid-pixelmania">

                <!-- ZONA 1 — Prezentare (Z-pattern) -->
                <section id="zona1" class="z-pattern">
                    <section id="welcome">
                        <hgroup class="z-1">
                            <h2>Bine ați venit</h2>
                            <p class="subtitlu">Locul unde consolele capătă o a doua viață</p>
                        </hgroup>

                        <p class="intro z-2">Indiferent dacă ești un pasionat cu experiență sau abia începi să explorezi
                            universul <b>jocurilor video</b>, la <b>Pixel Mania</b> găsești exact ce cauți.
                            Oferim <b>console</b> <b>second-hand</b> verificate, pentru orice buget și orice generație.
                        </p>

                        <div class="intro-oferte z-4">
                            <a href="/produse?marca=PlayStation" class="btn-oferta">PlayStation</a>
                            <a href="/produse?marca=Xbox" class="btn-oferta">Xbox</a>
                            <a href="/produse?marca=Nintendo" class="btn-oferta">Nintendo</a>
                            <a href="/produse?marca=Sega" class="btn-oferta">Sega</a>
                            <a href="/produse?marca=Altele" class="btn-oferta">Altele</a>
                        </div>

                        <p class="anunt intro">Comandă online și primești <b>consola</b> acasă, testată și pregătită
                            de utilizare. Sau vizitează-ne în magazin pentru a o testa înainte de achiziție.</p>

                        <div id="prezentare-consola-ext" class="z-3">
                            <div id="prezentare-consola">
                                <figure>
                                    <picture>
                                        <source srcset="/resurse/imagini630/ps4630.png" media="(max-width:700px)" />
                                        <source srcset="/resurse/imagini630/xboxseriesx630.png"
                                            media="(max-width:1200px)" />
                                        <img src="/resurse/imagini630/ps5630.png"
                                            alt="Console de jocuri video second-hand"
                                            title="Colecția noastră de console second-hand verificate și testate" />
                                    </picture>
                                    <figcaption>Fiecare consolă din imagine a trecut testul nostru de calitate
                                    </figcaption>
                                </figure>
                            </div>
                        </div>

                        <blockquote>
                            <p><q>Am achiziționat un PS4 de la Pixel Mania și funcționează impecabil. Calitatea
                                    produselor
                                    și seriozitatea echipei m-au convins să revin.</q></p>
                            <p>— <cite>Blogul RetroGamer România</cite>, recenzie din noiembrie 2025</p>
                        </blockquote>

                        <dl>
                            <dt><dfn>Console retro</dfn></dt>
                            <dd>Aparate de joacă fabricate între 1980 și 2005, apreciate de colecționari
                                și de pasionații care doresc să redescopere titlurile clasice din generațiile
                                anterioare.
                            </dd>
                            <dt>Console current-gen</dt>
                            <dd>Cele mai recente modele de pe piață (PS5, Xbox Series X/S, Nintendo Switch 2), cu
                                performanțe de top și grafică la rezoluție 4K.</dd>
                            <dt>Console last-gen</dt>
                            <dd>Generația precedentă (PS4, Xbox One, Switch original) — o alegere excelentă
                                pentru raportul calitate-preț, cu un catalog bogat de titluri disponibile.</dd>
                        </dl>

                        <div class="wrap separator-sectiune">
                          <div class="flared-horizontal-rule-effect">
                            <hr><hr>
                          </div>
                          <div class="flared-no-lines">
                            <hr><hr>
                          </div>
                        </div>

                        <!-- CERINTA video-vtt —— Video cu subtitluri VTT -->
                        <section id="sectiune-video">
                            <h2>Accesorii PlayStation — Pixel Mania</h2>
                            <p>Controllere PS4 originale și accesorii testate, disponibile în magazinul nostru:</p>
                            <video
                                id="video-consola"
                                poster="/resurse/imagini/ps4.png"
                                controls
                                preload="metadata"
                                muted>
                                <source src="/resurse/video/consola-promo.mp4" type="video/mp4">
                                <source src="/resurse/video/consola-promo.webm" type="video/webm">
                                <track
                                    default
                                    kind="captions"
                                    src="/resurse/video/vtt/ro.vtt"
                                    srclang="ro"
                                    label="Română">
                                <track
                                    kind="captions"
                                    src="/resurse/video/vtt/en.vtt"
                                    srclang="en"
                                    label="English">
                                <p>Browser-ul tău nu suportă tagul <code>video</code>.</p>
                            </video>
                        </section>
                    </section>
                </section>

                <!-- ZONA 2 — Tabel orar -->
